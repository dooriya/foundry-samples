{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results-manifest.v1.json",
  "title": "Responses API Feature Probe results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "notice",
    "target",
    "testedAt",
    "durationMs",
    "expectationsSource",
    "summary",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "reportType": {
      "const": "observed_capability_diagnostics"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "model",
        "apiFamily",
        "apiVersion",
        "authentication",
        "tokenScope",
        "requestTimeoutSeconds",
        "maxRetries"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiFamily": {
          "const": "openai/v1"
        },
        "apiVersion": {
          "type": "null"
        },
        "authentication": {
          "const": "default_azure_credential"
        },
        "tokenScope": {
          "type": "string",
          "minLength": 1
        },
        "requestTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "testedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "expectationsSource": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "local_file"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "unsupported",
        "not_applicable",
        "skipped",
        "inconclusive"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "name",
          "status",
          "expected",
          "expectationMatched",
          "durationMs",
          "observed",
          "error"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "expected": {
            "oneOf": [
              {
                "const": "unknown"
              },
              {
                "$ref": "#/$defs/status"
              }
            ]
          },
          "expectationMatched": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "observed": {
            "type": "object"
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "pass",
        "fail",
        "unsupported",
        "not_applicable",
        "skipped",
        "inconclusive"
      ]
    }
  }
}
