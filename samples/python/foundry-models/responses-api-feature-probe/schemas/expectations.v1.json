{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expectations.v1.json",
  "title": "Local Responses API Feature Probe expectations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "expectations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "pass",
              "fail",
              "unsupported",
              "not_applicable",
              "skipped",
              "inconclusive"
            ]
          }
        }
      }
    }
  }
}
